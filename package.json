{
  "name": "starterkit",
  "version": "1.0.0",
  "description": "for starter web page and learning the path of frontend web development",
  "license": "ISC",
  "author": "khalid",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "watch:sass": "sass src/sass:dist/css --watch",
    "serve": "browser-sync start --server --files 'dist/css/*.css, *.html'",
    "start": "npm-run-all --parallel watch:sass serve"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "browser-sync": "^3.0.4",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "sass": "^1.97.3"
  }
}
